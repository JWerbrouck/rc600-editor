    "B": { "name": "QUANTIZE", "values": ["OFF", "MEASURE"], "confidence": "likely" },
    "C": { "name": "AUTO REC SW", "values": ["OFF", "ON"], "confidence": "likely" },
    "D": { "name": "AUTO REC SENS", "range": [1, 100], "default": 50, "confidence": "likely" },
    "E": { "name": "BOUNCE SW", "values": ["OFF", "ON"], "confidence": "likely" },
    "F": { "name": "BOUNCE TRACK", "encoding": "bitmask over tracks 1-6 (63 = all)", "confidence": "likely" }
  },

  "PLAY": {
    "_note": "CURRENT TRACK from the guide is not stored here.",
    "A": { "name": "S.TRK CHANGE", "values": ["IMMEDIATE", "LOOP END"], "confidence": "likely" },
    "B": { "name": "FADE TIME IN", "encoding": "0..3 = four note lengths (0 = 1/16), 4..67 = 1..64 measures", "default": 5, "confidence": "confirmed", "evidence": "Round 1 test 8 (1MEAS = 4), round 2 test 5 (shortest = 0)" },
    "C": { "name": "FADE TIME OUT", "encoding": "same as FADE TIME IN", "default": 5, "confidence": "confirmed", "evidence": "Round 2 test 6: FADE OUT set to 64MEAS gave C = 67" },
    "D": { "name": "ALL START TRK", "encoding": "bitmask over tracks 1-6", "default": 63, "confidence": "likely" },
    "E": { "name": "ALL STOP TRK", "encoding": "bitmask over tracks 1-6", "default": 63, "confidence": "likely" },
    "F": { "name": "LOOP LENGTH", "encoding": "0 = AUTO, n = n measures", "confidence": "likely" },
    "G": { "name": "SPEED CHANGE", "values": ["IMMEDIATE", "LOOP END"], "confidence": "likely" },
    "H": { "name": "SYNC ADJUST", "values": ["BEAT", "MEASURE"], "default": 1, "confidence": "confirmed", "evidence": "Round 2 test 4: value 0 shows BEAT" }
  },

  "RHYTHM": {
