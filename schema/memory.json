    "D": { "name": "VAR.CHANGE", "values": ["MEASURE", "LOOP END"], "confidence": "likely", "evidence": "Test 13 set D 0 -> 1 (and M 0 -> 1)" },
    "E": { "name": "KIT", "values": ["STUDIO", "LIVE", "LIGHT", "HEAVY", "ROCK", "METAL", "JAZZ", "BRUSH", "CAJON", "DRUM&BASS", "R&B", "DANCE", "TECHNO", "DANCE BEATS", "HIPHOP", "808+909"], "confidence": "likely" },
    "F": { "name": "BEAT", "values": ["2/4", "3/4", "4/4", "5/4", "6/4", "7/4", "5/8", "6/8", "7/8", "8/8", "9/8", "10/8", "11/8", "12/8", "13/8", "14/8", "15/8"], "default": 2, "confidence": "confirmed", "evidence": "samples per measure match tempo x beats for 103 of 137 tracks exactly, the rest within 0.1 BPM rounding" },
    "G": { "name": "FILL", "values": ["OFF", "ON"], "default": 1, "confidence": "confirmed", "evidence": "Test 14" },
    "H": { "name": "INTRO REC", "values": ["OFF", "ON"], "confidence": "confirmed", "evidence": "Test 12" },
    "I": { "name": "INTRO PLAY", "values": ["OFF", "ON"], "confidence": "confirmed", "evidence": "Round 2 test 7" },
    "J": { "name": "ENDING", "values": ["OFF", "ON"], "confidence": "confirmed", "evidence": "Round 2 test 8" },
    "K": { "name": "START TRIG", "values": ["LOOP START", "REC END", "BEFORE LOOP"], "confidence": "confirmed", "evidence": "Test 10: 0 -> 2" },
    "L": { "name": "STOP TRIG", "values": ["OFF", "LOOP STOP", "REC END"], "default": 1, "confidence": "confirmed", "evidence": "Test 11: 1 -> 2" },
    "M": { "name": "(unknown, 0..2)", "confidence": "guess", "note": "Changed with VAR.CHANGE in test 13" }
  },

  "_partial": {
