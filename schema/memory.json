    "A": { "name": "GENRE", "values": ["ACOUSTIC", "BALLAD", "BLUES", "JAZZ", "FUSION", "R&B", "SOUL", "FUNK", "POP", "SOFT ROCK", "ROCK", "ALT ROCK", "PUNK", "HEAVY ROCK", "METAL", "TRAD", "WORLD", "BALLRM", "ELCTRO", "GUIDE", "USER"], "default": 19, "confidence": "likely" },
    "B": { "name": "PATTERN", "encoding": "index within genre (Rhythm Pattern List, p. 46)", "confidence": "likely" },
